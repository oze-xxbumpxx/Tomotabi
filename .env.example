# NestJS（apps/api）。未設定なら foundation は in-memory。
# 実 PostgreSQL 検証の代替ではない。Testcontainers は DATABASE_URL をテスト内で作る。
# ローカル DB（compose.yaml）を使う場合の例（app_runtime ロール）:
#   DATABASE_URL=postgres://app_runtime:app_runtime@127.0.0.1:5432/tomotabi
DATABASE_URL=

# migration 専用（migrator ロール）。管理者だけが `npm run db:migrate -w @tomotabi/api` で使う。
# ローカルの例: postgres://migrator:migrator@127.0.0.1:5432/tomotabi
# 実行用の DATABASE_URL をここに使わない。本番の値はこのファイルに書かない。
MIGRATION_DATABASE_URL=

# Next.js が /api を転送する先。末尾スラッシュなし。
API_ORIGIN=http://localhost:3001

# 公開アプリのオリジン。Next rewrite 越しに見える前置き（Origin 完全一致・Better Auth baseURL に使う）。末尾スラッシュなし。
PUBLIC_APP_ORIGIN=http://localhost:3000

# Better Auth の署名用秘密。本番の値はこのファイルに書かない。
BETTER_AUTH_SECRET=

# Google OAuth（ログイン用ウェブクライアント）。本番の値はこのファイルに書かない。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 初期登録 CLI（cli:enroll）専用の Google OAuth クライアント（デスクトップ型）。管理者端末だけで使う。本番の値はこのファイルに書かない。
ENROLL_GOOGLE_CLIENT_ID=
ENROLL_GOOGLE_CLIENT_SECRET=

# Nest の待受。Next rewrite と揃える。
PORT=3001

# Web Push の VAPID 鍵（JSON の配列）。current はちょうど1つ、revoked は秘密鍵を持たない。
# 未設定・形が崩れているときは通知の機能だけが止まる。鍵は npm run cli:generate-vapid-key -w @tomotabi/api -- --out <ファイル> で作る。
# 検証用の例（作り捨ての値。本番の鍵はこのファイルに書かない）:
#   VAPID_KEYS=[{"keyId":"2026-01","state":"current","publicKey":"BBOai5EF4AzuC39kG_o3Jbh_J75ualVHyfrR6F2iLIdJsB-Ur1RKpfw103sl9349lhNOweLTFf2FBZlmmRev5qk","privateKey":"gdq4yY8Il0t5AtS8OJJzCLHzgX8KgK2mVRNIzOuDgkw"}]
VAPID_KEYS=

# 配信サービスに示す運用者の連絡先（mailto:またはhttps:）。本番の値はこのファイルに書かない。
VAPID_SUBJECT=mailto:push-admin@example.test
