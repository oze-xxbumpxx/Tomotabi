{
  "openapi": "3.1.0",
  "info": {
    "title": "旅行アプリ 支払い・精算API",
    "version": "0.1.0-design",
    "description": "支払い・精算の詳細設計。認証はBetter AuthのDBセッションCookie。詳細は03_認証とセッション.md。セッション検証後、利用許可と旅行参加者を検証する。"
  },
  "servers": [
    {
      "url": "/api",
      "description": "同一オリジンの公開API接頭辞の設計案。NestJSへのルーティングと認証伝達は認証詳細設計で決定。"
    }
  ],
  "security": [
    {
      "SessionCookie": []
    }
  ],
  "tags": [
    {
      "name": "Finance",
      "description": "支払いと精算"
    }
  ],
  "paths": {
    "/trips/{tripId}/payments": {
      "post": {
        "operationId": "createPayment",
        "summary": "支払いを記録",
        "description": " 業務POSTはOrigin完全一致とContent-Type application/jsonを必要とする。bodyなしの操作も同ヘッダーを送信する。",
