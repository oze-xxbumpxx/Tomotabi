  "components": {
    "schemas": {
      "Trip": {
        "$ref": "./openapi.planning.json#/components/schemas/Trip"
      },
      "TripCreate": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "startsOn": {
            "type": "string",
            "format": "date"
          },
          "endsOn": {
            "type": "string",
            "format": "date"
          }
        },
        "required": [
          "name",
          "startsOn",
          "endsOn"
        ],
        "additionalProperties": false
      },
      "TripRename": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      },
      "TripPage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Trip"
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "items",
          "nextCursor"
        ],
        "additionalProperties": false
      },
      "Context": {
        "type": "object",
        "properties": {
          "today": {
            "type": "string",
            "format": "date"
          },
          "mode": {
            "enum": [
              "before",
              "during",
              "after_dates",
              "completed"
            ]
          },
          "targetDate": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "dayNumber": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "daysUntilStart": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "suggestedAction": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "start",
              "finish",
              null
            ]
          }
        },
        "required": [
          "today",
          "mode",
          "targetDate",
          "dayNumber",
          "daysUntilStart",
          "suggestedAction"
        ],
        "additionalProperties": false
      },
      "Schedule": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "items": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "$ref": "./openapi.planning.json#/components/schemas/Plan"
            }
          },
          "totalCount": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "date",
          "items",
          "totalCount"
        ],
        "additionalProperties": false
      },
      "BalanceSummary": {
        "type": "object",
        "properties": {
          "transfer": {
            "$ref": "./openapi.finance.json#/components/schemas/Transfer"
          },
          "targetCount": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "transfer",
          "targetCount"
        ],
        "additionalProperties": false
      },
      "Home": {
        "type": "object",
        "properties": {
          "trip": {
            "$ref": "#/components/schemas/Trip"
          },
          "context": {
            "$ref": "#/components/schemas/Context"
          },
          "schedule": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "status": {
                    "const": "ok"
                  },
                  "data": {
                    "oneOf": [
                      {
                        "$ref": "#/components/schemas/Schedule"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "status",
                  "data"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "status": {
                    "const": "unavailable"
                  },
                  "code": {
                    "const": "TEMPORARILY_UNAVAILABLE"
                  }
                },
                "required": [
                  "status",
                  "code"
                ],
                "additionalProperties": false
              }
            ]
          },
          "balance": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "status": {
                    "const": "ok"
                  },
                  "data": {
                    "$ref": "#/components/schemas/BalanceSummary"
                  }
                },
                "required": [
                  "status",
                  "data"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "status": {
                    "const": "unavailable"
                  },
                  "code": {
                    "const": "TEMPORARILY_UNAVAILABLE"
                  }
                },
                "required": [
                  "status",
                  "code"
                ],
                "additionalProperties": false
              }
            ]
          },
          "recentRecords": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "status": {
                    "const": "ok"
                  },
                  "data": {
                    "type": "array",
                    "maxItems": 3,
                    "items": {
                      "$ref": "./openapi.planning.json#/components/schemas/TimelineItem"
                    }
                  }
                },
                "required": [
                  "status",
                  "data"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "status": {
                    "const": "unavailable"
                  },
                  "code": {
                    "const": "TEMPORARILY_UNAVAILABLE"
                  }
                },
                "required": [
                  "status",
                  "code"
                ],
                "additionalProperties": false
              }
            ]
          },
          "fetchedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "trip",
          "context",
          "schedule",
          "balance",
          "recentRecords",
          "fetchedAt"
        ],
        "additionalProperties": false
      },
      "Error": {
        "$ref": "./openapi.finance.json#/components/schemas/Error"
      }
    },
    "parameters": {
      "tripId": {
        "name": "tripId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "Origin": {
        "name": "Origin",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uri"
        },
        "description": "公開アプリのオリジンと完全一致が必要。欠落・null・別オリジンは403。認証そのものの代替ではない。"
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        },
        "description": "利用者・操作単位の再送識別子。同じ論理操作の再送には同じキー。tripId、対象ID、正規化bodyをrequest hashに含める。"
      },
      "IfMatch": {
        "name": "If-Match",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^\"[1-9][0-9]*\"$"
        },
        "description": "単一の強いETag。欠落428、不一致409。同一キー成功再送は認可後に元の結果を返す。"
      }
    },
    "securitySchemes": {
      "SessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Secure-travel.session_token",
        "description": "本番のHTTPS・同一オリジン用。Better Authが署名とDBセッションを検証し、利用許可と旅行参加者を別途確認する。ローカル開発Cookie名は別設定。"
      }
    }
  }
}
