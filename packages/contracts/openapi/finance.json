            "schema": {
              "type": "string",
              "maxLength": 2048
            },
            "description": "サーバー発行の不透明カーソル。対象旅行・フィルターを検証する。"
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "正常結果",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettlementPage"
                }
              }
            }
          },
          "400": {
            "description": "形式違反",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "認証・認可エラー",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "旅行が無い・参加していない（TRIP_NOT_ACCESSIBLE）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "一時的な障害（TEMPORARILY_UNAVAILABLE。retryable）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
