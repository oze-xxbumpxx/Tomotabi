    "/api/trips/{tripId}/settlements": {
      "post": {
        "operationId": "completeSettlement",
        "description": "確認を指定して受け渡しの完了を記録する。Idempotency-Key 必須。元の確認の金額でのみ記録。取り消された BASE 対象を含むときは了承した paymentId の集合と現在の取り消し済み集合の完全一致を検証する。",
        "parameters": [
          {
            "$ref": "#/components/parameters/tripId"
          },
          {
            "$ref": "#/components/parameters/Origin"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SettlementCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "記録した。同じキーの成功の再送も元の本文を返す",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Settlement"
                }
              }
            }
          },
          "200": {
            "description": "同じ確認はすでに完了している。既存の精算を返す",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Settlement"
                }
              }
            }
          },
          "400": {
            "description": "形式違反",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "認証・認可エラー",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "旅行が無い・参加していない（TRIP_NOT_ACCESSIBLE）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "旅行の中に確認が無い（PREVIEW_NOT_FOUND）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "競合（PREVIEW_CHANGED・CANCELLED_ITEMS_ACK_REQUIRED・TARGET_ALREADY_SETTLED・TARGET_PARTIALLY_SETTLED・IDEMPOTENCY_KEY_REUSED。取り消し済みの確認の再完了も 409）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "値の規則違反（VALIDATION_FAILED。completionKind と合計 0 円の組み合わせなど）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "一時的な障害（TEMPORARILY_UNAVAILABLE。retryable）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "get": {
