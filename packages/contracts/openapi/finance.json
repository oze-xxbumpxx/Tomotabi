{
  "openapi": "3.1.0",
  "info": {
    "title": "Tomotabi finance boundary",
    "version": "0.0.0",
    "description": "支払い・精算の公開 API 契約。docs/旅行アプリ設計 3/詳細設計/openapi.finance.json を移植。支払い額の上限は 9,999,999 円（要件定義 F-02・設計書「正本からの差分」）。エラーの code は設計書「API 設計」どおり。"
  },
  "security": [
    {
      "SessionCookie": []
    }
  ],
  "paths": {
    "/api/trips/{tripId}/payments": {
      "post": {
        "operationId": "createPayment",
        "description": "支払いを記録。Idempotency-Key 必須。負担額・寄与はサーバーが計算する（クライアントの申告で確定しない）。",
        "parameters": [
          {
            "$ref": "#/components/parameters/tripId"
          },
          {
            "$ref": "#/components/parameters/Origin"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PaymentCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "記録した。同じキーの成功の再送も元の 201 と同じ本文を返す",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Payment"
                }
              }
            }
          },
          "400": {
            "description": "形式違反",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "認証・認可エラー",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "旅行が無い・参加していない（TRIP_NOT_ACCESSIBLE）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "競合（IDEMPOTENCY_KEY_REUSED）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "値の規則違反（VALIDATION_FAILED。金額 1〜9,999,999 円・割合 0〜100・用途・関連する予定は同じ旅行のもの）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "一時的な障害（TEMPORARILY_UNAVAILABLE。retryable）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/trips/{tripId}/payments/{id}": {
      "get": {
        "operationId": "getPayment",
        "description": "支払い 1 件を返す（取り消し状態を含む）。旅行の中に支払いが無い・別の旅行の支払いは 404 PAYMENT_NOT_FOUND。",
        "parameters": [
          {
            "$ref": "#/components/parameters/tripId"
          },
          {
            "$ref": "#/components/parameters/id"
          }
        ],
        "responses": {
          "200": {
            "description": "正常結果",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Payment"
                }
              }
            }
          },
          "400": {
            "description": "形式違反",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "認証・認可エラー",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "旅行が無い・参加していない（TRIP_NOT_ACCESSIBLE）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "旅行の中に支払いが無い（PAYMENT_NOT_FOUND）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "一時的な障害（TEMPORARILY_UNAVAILABLE。retryable）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/trips/{tripId}/payments/{id}/cancel": {
      "post": {
        "operationId": "cancelPayment",
        "description": "支払いを取り消す。Idempotency-Key 必須。取り消しは別の記録を足す形（元の支払いは残る）。",
        "parameters": [
          {
            "$ref": "#/components/parameters/tripId"
          },
          {
            "$ref": "#/components/parameters/id"
          },
          {
            "$ref": "#/components/parameters/Origin"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "responses": {
          "201": {
            "description": "取り消した。同じキーの成功の再送も元の本文を返す",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Cancellation"
                }
              }
            }
          },
          "200": {
            "description": "既に取り消し済み。既存の取り消しを返す",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Cancellation"
                }
              }
            }
          },
          "400": {
            "description": "形式違反",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "認証・認可エラー",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "旅行が無い・参加していない（TRIP_NOT_ACCESSIBLE）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "旅行の中に支払いが無い（PAYMENT_NOT_FOUND）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "競合（IDEMPOTENCY_KEY_REUSED）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "一時的な障害（TEMPORARILY_UNAVAILABLE。retryable）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/trips/{tripId}/balance": {
      "get": {
        "operationId": "getBalance",
        "description": "残額（向き・金額・対象の件数・明細）を返す。保存済みの支払い・精算・取り消しから導出する。参照のみで確認は作らない。",
        "parameters": [
          {
            "$ref": "#/components/parameters/tripId"
          }
        ],
        "responses": {
          "200": {
            "description": "正常結果",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Balance"
                }
              }
            }
          },
          "400": {
            "description": "形式違反",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "認証・認可エラー",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "旅行が無い・参加していない（TRIP_NOT_ACCESSIBLE）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "一時的な障害（TEMPORARILY_UNAVAILABLE。retryable）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/trips/{tripId}/settlement-previews": {
      "post": {
        "operationId": "createSettlementPreview",
        "description": "その時点の対象をすべて固定した受け渡しの確認を作る。Idempotency-Key 必須。自動で期限切れにしない。対象 0 件では作れない。",
        "parameters": [
          {
            "$ref": "#/components/parameters/tripId"
          },
          {
            "$ref": "#/components/parameters/Origin"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "responses": {
          "201": {
            "description": "作った。同じキーの成功の再送も元の本文を返す",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Preview"
                }
              }
            }
          },
          "400": {
            "description": "形式違反",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "認証・認可エラー",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "旅行が無い・参加していない（TRIP_NOT_ACCESSIBLE）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "競合（IDEMPOTENCY_KEY_REUSED）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "対象が無い（NO_SETTLEMENT_TARGET）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "一時的な障害（TEMPORARILY_UNAVAILABLE。retryable）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "listSettlementPreviews",
        "description": "自分の未完了の確認を新しい順に返す。競合で無効になった確認も理由つきで返す。完了後に取り消された確認は再利用できないので除く。自動では選ばない。",
        "parameters": [
          {
            "$ref": "#/components/parameters/tripId"
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "pending"
              ],
              "default": "pending"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 2048
            },
            "description": "サーバー発行の不透明カーソル。対象旅行・フィルターを検証する。"
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "正常結果",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PreviewPage"
                }
              }
            }
          },
          "400": {
            "description": "形式違反",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "認証・認可エラー",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "旅行が無い・参加していない（TRIP_NOT_ACCESSIBLE）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "一時的な障害（TEMPORARILY_UNAVAILABLE。retryable）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/trips/{tripId}/settlement-previews/{id}": {
      "get": {
        "operationId": "getSettlementPreview",
        "description": "確認を 1 件返す。元の明細と、取得時点の検証結果（validation）を含む。固定した明細・金額はあとから変わらない。",
