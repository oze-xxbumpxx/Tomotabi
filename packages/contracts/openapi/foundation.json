{
  "openapi": "3.1.0",
  "info": {
    "title": "Tomotabi M0 foundation",
    "version": "0.0.0",
    "description": "Compatibility probe only. Not a product feature."
  },
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Process is up",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["status"],
                  "properties": {
                    "status": { "const": "ok" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/health/migrations": {
      "get": {
        "operationId": "getMigrationStatus",
        "description": "Last applied migration time for the deploy workflow. Public, returns one timestamp only.",
        "responses": {
          "200": {
            "description": "Last applied migration time",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MigrationStatusView" }
              }
            }
          }
        }
      }
    },
    "/api/foundation/probes": {
      "get": {
        "operationId": "getProbe",
        "responses": {
          "200": {
            "description": "Current probe count",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ProbeView" }
              }
            }
          }
        }
      }
    },
    "/api/foundation/probes/increment": {
      "post": {
        "operationId": "incrementProbe",
        "responses": {
          "200": {
            "description": "Incremented probe count",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ProbeView" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "MigrationStatusView": {
        "type": "object",
        "required": ["lastAppliedAt"],
        "additionalProperties": false,
        "properties": {
          "lastAppliedAt": {
            "type": ["integer", "null"],
            "description": "Milliseconds, same value as \"when\" in apps/api/drizzle/meta/_journal.json. null when no migration is applied."
          }
        }
      },
      "ProbeView": {
        "type": "object",
        "required": ["count"],
        "properties": {
          "count": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
