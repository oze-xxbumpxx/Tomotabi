{
  "openapi": "3.1.0",
  "info": {
    "title": "Tomotabi planning boundary",
    "version": "0.0.0",
    "description": "予定・しおり・旅行期間の公開 API 契約。docs/旅行アプリ設計 3/詳細設計/openapi.planning.json から M2 の操作を移植。getTrip は trips.json にだけ置く。"
  },
  "security": [
    {
      "SessionCookie": []
    }
  ],
  "paths": {
    "/api/trips/{tripId}/itinerary": {
      "get": {
        "operationId": "getItinerary",
        "description": "認可済み旅行の日別予定。時刻昇順、未定は末尾、同時刻は登録日時・ID順。date 省略時は日本時間の今日（期間外なら初日）。期間外の日付は 422。",
        "parameters": [
          {
            "$ref": "#/components/parameters/tripId"
          },
          {
            "name": "date",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "正常結果",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Itinerary"
                }
              }
            }
          },
          "400": {
            "description": "形式違反",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "認証・認可エラー",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "旅行が無い・参加していない（TRIP_NOT_ACCESSIBLE）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "期間外の日付など値の規則違反",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "一時的な障害",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/trips/{tripId}/plans": {
      "post": {
        "operationId": "createPlan",
        "description": "予定の追加。Idempotency-Key 必須。日付は旅行期間内。",
        "parameters": [
          {
            "$ref": "#/components/parameters/tripId"
          },
          {
            "$ref": "#/components/parameters/Origin"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PlanCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "新規作成",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Plan"
                }
              }
            },
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                },
                "description": "成功時の予定version。引用付き10進整数。"
              }
            }
          },
          "200": {
            "description": "同じキーの成功再送",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Plan"
                }
              }
            },
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                },
                "description": "成功時の予定version。引用付き10進整数。"
              }
            }
          },
          "400": {
            "description": "形式違反",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "認証・認可エラー",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "旅行が無い・参加していない（TRIP_NOT_ACCESSIBLE）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "競合（IDEMPOTENCY_KEY_REUSED）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "値の規則違反（PLAN_OUTSIDE_TRIP_PERIOD など）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "一時的な障害",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
