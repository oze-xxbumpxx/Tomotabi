                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "旅行の中に予定が無い（PLAN_NOT_FOUND）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
