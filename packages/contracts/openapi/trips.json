      "Transfer": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "signedTotalYen": {
            "type": "string",
            "pattern": "^(0|-?[1-9][0-9]*)$",
            "maxLength": 20,
            "description": "slot 1からslot 0を正とする円単位整数。UIではuserIdに対応付けて方向表示。"
          },
          "amountYen": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$",
            "maxLength": 19,
            "description": "円単位の非負整数。BigIntから10進文字列へ変換。"
          },
          "fromUserId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "toUserId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "requiresTransfer": {
            "type": "boolean"
          }
        },
        "required": [
          "signedTotalYen",
          "amountYen",
          "fromUserId",
          "toUserId",
          "requiresTransfer"
        ],
        "description": "0円ならfrom/toはnull、requiresTransfer=false。非0ならfromとtoは異なる旅行参加者。全フィールドの整合性をサーバーで保証。"
      },
