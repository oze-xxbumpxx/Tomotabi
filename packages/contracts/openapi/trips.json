{
  "openapi": "3.1.0",
  "info": {
    "title": "Tomotabi trips boundary",
    "version": "0.0.0",
    "description": "旅行・ホームの公開 API 契約。docs/旅行アプリ設計 3/詳細設計/openapi.trips.json から移植（getTrip はここにだけ置く）。"
  },
  "security": [
    {
      "SessionCookie": []
    }
  ],
  "paths": {
    "/api/trips": {
      "post": {
        "operationId": "createTrip",
        "description": "旅行・二人の参加者・財務 guard を同時に作成。Idempotency-Key 必須。同じキーの成功再送は元の結果を返す。",
        "parameters": [
          {
            "$ref": "#/components/parameters/Origin"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TripCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "作成した。同じキーの成功の再送も元の 201 と同じ本文を返す",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Trip"
                }
              }
            },
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                },
                "description": "引用付きversion"
              }
            }
          },
          "400": {
            "description": "形式違反",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "認証・認可エラー",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "認証・認可エラー",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "競合（IDEMPOTENCY_KEY_REUSED・PARTICIPANTS_NOT_READY）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "値の規則違反",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "一時的な障害",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "listTrips",
        "description": "自分が参加する旅行を新しい順に返す。カーソルは (created_at, id) の不透明な文字列。",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "enum": [
                "planning",
                "traveling",
                "finished"
              ]
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 2048
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "正常結果",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TripPage"
                }
              }
            }
          },
          "400": {
            "description": "形式違反",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "認証・認可エラー",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "認証・認可エラー",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "一時的な障害",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/trips/{tripId}": {
      "get": {
        "operationId": "getTrip",
        "description": "旅行 1 件を ETag 付きで返す。参加していない・存在しない旅行は 403 TRIP_NOT_ACCESSIBLE（存在を漏らさない）。",
        "parameters": [
          {
            "$ref": "#/components/parameters/tripId"
          }
        ],
        "responses": {
          "200": {
            "description": "正常結果",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Trip"
                }
              }
            },
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                },
                "description": "引用付きversion"
              }
            }
          },
          "400": {
            "description": "形式違反",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "認証・認可エラー",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "旅行が無い・参加していない（TRIP_NOT_ACCESSIBLE）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "一時的な障害",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "patch": {
        "operationId": "renameTrip",
        "description": "旅行名の変更。Idempotency-Key・If-Match 必須。",
        "parameters": [
          {
            "$ref": "#/components/parameters/tripId"
          },
          {
            "$ref": "#/components/parameters/Origin"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          },
          {
            "$ref": "#/components/parameters/IfMatch"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TripRename"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "正常結果・同じキーの成功再送",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Trip"
                }
              }
            },
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                },
                "description": "引用付きversion"
              }
            }
          },
          "400": {
            "description": "形式違反",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "認証・認可エラー",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "旅行が無い・参加していない（TRIP_NOT_ACCESSIBLE）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "競合（VERSION_CONFLICT・IDEMPOTENCY_KEY_REUSED）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "値の規則違反",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "428": {
            "description": "If-Match 欠落（IF_MATCH_REQUIRED）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "一時的な障害",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/trips/{tripId}/start": {
      "post": {
        "operationId": "startTrip",
        "description": "planning → traveling。同じ状態への遷移は変化なしで 200。",
        "parameters": [
          {
            "$ref": "#/components/parameters/tripId"
          },
          {
            "$ref": "#/components/parameters/Origin"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          },
          {
            "$ref": "#/components/parameters/IfMatch"
          }
        ],
        "responses": {
          "200": {
            "description": "正常結果・同じキーの成功再送",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Trip"
                }
              }
            },
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                },
                "description": "引用付きversion"
              }
            }
          },
          "400": {
            "description": "形式違反",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "認証・認可エラー",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "旅行が無い・参加していない（TRIP_NOT_ACCESSIBLE）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "競合（INVALID_TRIP_TRANSITION・VERSION_CONFLICT・IDEMPOTENCY_KEY_REUSED）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "428": {
            "description": "If-Match 欠落（IF_MATCH_REQUIRED）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "一時的な障害",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/trips/{tripId}/finish": {
      "post": {
        "operationId": "finishTrip",
        "description": "traveling → finished。同じ状態への遷移は変化なしで 200。",
        "parameters": [
          {
            "$ref": "#/components/parameters/tripId"
          },
          {
            "$ref": "#/components/parameters/Origin"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          },
          {
            "$ref": "#/components/parameters/IfMatch"
          }
        ],
        "responses": {
          "200": {
            "description": "正常結果・同じキーの成功再送",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Trip"
                }
              }
            },
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                },
                "description": "引用付きversion"
              }
            }
          },
          "400": {
            "description": "形式違反",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "認証・認可エラー",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "旅行が無い・参加していない（TRIP_NOT_ACCESSIBLE）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "競合（INVALID_TRIP_TRANSITION・VERSION_CONFLICT・IDEMPOTENCY_KEY_REUSED）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "428": {
            "description": "If-Match 欠落（IF_MATCH_REQUIRED）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "一時的な障害",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/trips/{tripId}/home": {
      "get": {
        "operationId": "getHome",
        "description": "ホームの欄をまとめて返す。旅行・認可の取得に失敗した場合は全体が 401・403・404・503。欄ごとの回復可能な失敗はその欄を status=unavailable で返す（失敗した金額を0円に置き換えない）。`Cache-Control: private, no-store`。",
        "parameters": [
          {
            "$ref": "#/components/parameters/tripId"
          }
        ],
        "responses": {
          "200": {
            "description": "正常結果",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Home"
                }
              }
            }
          },
          "400": {
            "description": "形式違反",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "認証・認可エラー",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "旅行が無い・参加していない（TRIP_NOT_ACCESSIBLE）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "旅行が無い",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "一時的な障害",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "SessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Secure-travel.session_token",
        "description": "本番のHTTPS・同一オリジン用。Better Authが署名とDBセッションを検証し、利用許可と旅行参加者を別途確認する。ローカル開発Cookie名は別設定。"
      }
    },
    "parameters": {
      "tripId": {
        "name": "tripId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "Origin": {
        "name": "Origin",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uri"
        },
        "description": "公開アプリのオリジンと完全一致が必要。欠落・null・別オリジンは403。認証そのものの代替ではない。"
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        },
        "description": "利用者・操作単位の再送識別子。同じ論理操作の再送には同じキー。tripId、対象ID、正規化bodyをrequest hashに含める。"
      },
      "IfMatch": {
        "name": "If-Match",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^\"[1-9][0-9]*\"$"
        },
        "description": "単一の強いETag。欠落428、不一致409。同一キー成功再送は認可後に元の結果を返す。"
      }
    },
    "schemas": {
      "Trip": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "startsOn": {
            "type": "string",
            "format": "date"
          },
          "endsOn": {
            "type": "string",
            "format": "date"
          },
          "status": {
            "type": "string",
            "enum": [
              "planning",
              "traveling",
              "finished"
            ]
          },
          "version": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "startedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "finishedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "createdBy": {
            "type": "string",
            "format": "uuid"
          },
          "startedBy": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "finishedBy": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          }
        },
        "required": [
          "id",
          "name",
          "startsOn",
          "endsOn",
          "status",
          "version",
          "createdAt",
          "startedAt",
          "finishedAt",
          "createdBy",
          "startedBy",
          "finishedBy"
        ]
      },
      "TripCreate": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "startsOn": {
            "type": "string",
            "format": "date"
          },
          "endsOn": {
            "type": "string",
            "format": "date"
          }
        },
        "required": [
          "name",
          "startsOn",
          "endsOn"
        ],
        "additionalProperties": false
      },
      "TripRename": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      },
      "TripPage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Trip"
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "items",
          "nextCursor"
        ],
        "additionalProperties": false
      },
      "Context": {
        "type": "object",
        "properties": {
          "today": {
            "type": "string",
            "format": "date"
          },
          "mode": {
            "enum": [
              "before",
              "during",
              "after_dates",
              "completed"
            ]
          },
          "targetDate": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "dayNumber": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "daysUntilStart": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "suggestedAction": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "start",
              "finish",
              null
            ]
          }
        },
        "required": [
          "today",
          "mode",
          "targetDate",
          "dayNumber",
          "daysUntilStart",
          "suggestedAction"
        ],
        "additionalProperties": false
      },
      "Schedule": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "items": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "$ref": "#/components/schemas/Plan"
            }
          },
          "totalCount": {
            "type": "integer",
            "minimum": 0
          },
          "achievedCount": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "date",
          "items",
          "totalCount",
          "achievedCount"
        ],
        "additionalProperties": false
      },
      "BalanceSummary": {
        "type": "object",
        "properties": {
          "transfer": {
            "$ref": "#/components/schemas/Transfer"
          },
          "targetCount": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "transfer",
          "targetCount"
        ],
        "additionalProperties": false
      },
      "Home": {
        "type": "object",
        "properties": {
          "trip": {
            "$ref": "#/components/schemas/Trip"
          },
          "context": {
            "$ref": "#/components/schemas/Context"
          },
          "schedule": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "status": {
                    "const": "ok"
                  },
                  "data": {
                    "oneOf": [
                      {
                        "$ref": "#/components/schemas/Schedule"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "status",
                  "data"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "status": {
                    "const": "unavailable"
                  },
                  "code": {
                    "const": "TEMPORARILY_UNAVAILABLE"
                  }
                },
                "required": [
                  "status",
                  "code"
                ],
                "additionalProperties": false
              }
            ]
          },
          "balance": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "status": {
                    "const": "ok"
                  },
                  "data": {
                    "$ref": "#/components/schemas/BalanceSummary"
                  }
                },
                "required": [
                  "status",
                  "data"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "status": {
                    "const": "unavailable"
                  },
                  "code": {
                    "const": "TEMPORARILY_UNAVAILABLE"
                  }
                },
                "required": [
                  "status",
                  "code"
                ],
                "additionalProperties": false
              }
            ]
          },
          "recentRecords": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "status": {
                    "const": "ok"
                  },
                  "data": {
                    "type": "array",
                    "maxItems": 3,
                    "items": {
                      "$ref": "#/components/schemas/TimelineItem"
                    }
                  }
                },
                "required": [
                  "status",
                  "data"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
