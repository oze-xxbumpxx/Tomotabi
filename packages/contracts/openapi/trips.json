                  "code": {
                    "const": "TEMPORARILY_UNAVAILABLE"
                  }
                },
                "required": [
                  "status",
                  "code"
                ],
                "additionalProperties": false
              }
            ]
          },
          "fetchedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "trip",
          "context",
          "schedule",
          "balance",
          "recentRecords",
          "fetchedAt"
        ],
        "additionalProperties": false
      },
      "Plan": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "tripId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "kind": {
            "type": "string",
            "enum": [
              "place",
              "food",
              "shopping",
              "lodging",
              "transport"
            ]
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "time": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
          },
          "memo": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2000
          },
          "cancelledAt": {
            "oneOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "cancelledBy": {
            "oneOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          },
          "version": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "achievement": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Event"
              },
              {
                "type": "null"
              }
            ]
          },
          "booking": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Event"
              },
              {
                "type": "null"
              }
            ]
          },
          "canChangeKind": {
            "type": "boolean"
          },
          "kindChangeReason": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              null,
              "record_history_exists"
            ]
          }
        },
        "required": [
          "id",
          "tripId",
          "name",
          "kind",
          "date",
          "time",
          "memo",
          "cancelledAt",
          "cancelledBy",
          "version",
          "achievement",
          "booking",
          "canChangeKind",
          "kindChangeReason"
